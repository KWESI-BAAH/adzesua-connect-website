rules_version = '2';
// Adzesua HQ — Firestore security rules. Generated from js/roles.js; paste into
// Firebase console → Firestore Database → Rules, then Publish.
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    function memberDoc() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function inviteDoc() { return /databases/$(database)/documents/invites/$(email()); }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function isMember() { return isOwner() || (signedIn() && exists(memberDoc())); }
    function role() { return isOwner() ? 'Admin' : (signedIn() && exists(memberDoc()) ? get(memberDoc()).data.role : 'none'); }
    function hasRole(rs) { return isMember() && role() in rs; }
    function validRole(r) { return r in ['Admin', 'BizDev', 'Finance', 'Ops', 'Agent', 'HR', 'Auditor', 'Viewer']; }
    // Every record carries its own id; a write may not smuggle in a different one.
    function okDoc(docId) { return request.resource.data.id == docId; }
    function shortText(v, n) { return v == null || (v is string && v.size() <= n); }

    // The first person to sign in with a verified email becomes the owner (Managing Director).
    match /config/owner {
      allow read: if signedIn();
      allow create: if verified() && !exists(ownerDoc())
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid;
    }
    // Invitations: admins invite by email; the invited person may read their own.
    match /invites/{inviteEmail} {
      allow read: if hasRole(['Admin']) || (signedIn() && email() == inviteEmail);
      allow write: if hasRole(['Admin']);
    }
    match /members/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if (hasRole(['Admin']) && validRole(request.resource.data.role))
        || (verified() && request.auth.uid == uid && exists(inviteDoc())
            && request.resource.data.keys().hasOnly(['id', 'role', 'staffId', 'name', 'email', 'joinedAt'])
            && request.resource.data.id == uid
            && request.resource.data.email == email()
            && request.resource.data.role == get(inviteDoc()).data.role
            && shortText(request.resource.data.name, 120));
      allow update: if hasRole(['Admin']) && validRole(request.resource.data.role);
      allow delete: if hasRole(['Admin']);
    }
    // People who signed in without an invitation ask for access here; admins review them in Setup.
    match /requests/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'email', 'name', 'provider', 'check', 'at'])
        && request.resource.data.id == uid
        && shortText(request.resource.data.name, 120) && shortText(request.resource.data.email, 200)
        && shortText(request.resource.data.provider, 40) && shortText(request.resource.data.check, 80) && shortText(request.resource.data.at, 40);
      allow read: if hasRole(['Admin']) || (signedIn() && request.auth.uid == uid);
      allow delete: if hasRole(['Admin']) || (signedIn() && request.auth.uid == uid);
    }
    match /settings/{id} {
      allow read: if isMember();
      allow write: if hasRole(['Admin', 'Finance', 'HR']);
    }
    match /schools/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'BizDev']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'BizDev']);
    }
    match /contacts/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'BizDev']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'BizDev']);
    }
    match /deals/{id} {
      allow read: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'Agent', 'Auditor', 'Viewer']);
      allow create: if hasRole(['Admin', 'BizDev']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'BizDev']);
    }
    match /activities/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'Agent', 'HR']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'Agent', 'HR']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'HR']);
    }
    match /batches/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'BizDev', 'Ops']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev', 'Ops']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'BizDev', 'Ops']);
    }
    match /cards/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'BizDev', 'Ops', 'Agent']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev', 'Ops', 'Agent']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'BizDev', 'Ops']);
    }
    match /devices/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'Ops']) && okDoc(id);
      allow update: if hasRole(['Admin', 'Ops']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Ops']);
    }
    match /items/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'Finance', 'Ops']) && okDoc(id);
      allow update: if hasRole(['Admin', 'Finance', 'Ops']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Finance', 'Ops']);
    }
    match /moves/{id} {
      allow read: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'Agent', 'Auditor']);
      allow create: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops']);
    }
    match /suppliers/{id} {
      allow read: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'Auditor']);
      allow create: if hasRole(['Admin', 'Finance', 'Ops']) && okDoc(id);
      allow update: if hasRole(['Admin', 'Finance', 'Ops']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Finance', 'Ops']);
    }
    match /purchases/{id} {
      allow read: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'Auditor']);
      allow create: if hasRole(['Admin', 'Finance', 'Ops']) && okDoc(id);
      allow update: if hasRole(['Admin', 'Finance', 'Ops']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Finance']);
    }
    match /sales/{id} {
      allow read: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'Agent', 'Auditor']);
      allow create: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'Agent']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Finance']);
    }
    match /expenses/{id} {
      allow read: if hasRole(['Admin', 'BizDev', 'Finance', 'Auditor']);
      allow create: if hasRole(['Admin', 'BizDev', 'Finance']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev', 'Finance']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Finance']);
    }
    match /journals/{id} {
      allow read: if hasRole(['Admin', 'Finance', 'HR', 'Auditor']);
      allow create: if hasRole(['Admin', 'Finance', 'HR']) && okDoc(id);
      allow update: if hasRole(['Admin', 'Finance', 'HR']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Finance', 'HR']);
    }
    match /staff/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'HR']) && okDoc(id);
      allow update: if hasRole(['Admin', 'HR']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'HR']);
    }
    match /products/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin']) && okDoc(id);
      allow update: if hasRole(['Admin']) && okDoc(id);
      allow delete: if hasRole(['Admin']);
    }
    match /accounts/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin']) && okDoc(id);
      allow update: if hasRole(['Admin']) && okDoc(id);
      allow delete: if hasRole(['Admin']);
    }
    match /departments/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'HR']) && okDoc(id);
      allow update: if hasRole(['Admin', 'HR']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'HR']);
    }
    match /leave/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'Agent', 'HR', 'Viewer']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'Agent', 'HR', 'Viewer']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'BizDev', 'Finance', 'Ops', 'HR', 'Viewer']);
    }
    match /staffpay/{id} {
      allow read: if hasRole(['Admin', 'Finance', 'HR']);
      allow create: if hasRole(['Admin', 'Finance', 'HR']) && okDoc(id);
      allow update: if hasRole(['Admin', 'Finance', 'HR']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Finance', 'HR']);
    }
    match /payruns/{id} {
      allow read: if hasRole(['Admin', 'Finance', 'HR']);
      allow create: if hasRole(['Admin', 'Finance', 'HR']) && okDoc(id);
      allow update: if hasRole(['Admin', 'Finance', 'HR']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Finance', 'HR']);
    }
    match /advances/{id} {
      allow read: if hasRole(['Admin', 'Finance', 'HR']);
      allow create: if hasRole(['Admin', 'Finance', 'HR']) && okDoc(id);
      allow update: if hasRole(['Admin', 'Finance', 'HR']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Finance', 'HR']);
    }
    match /tickets/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'BizDev', 'Ops', 'Agent']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev', 'Ops', 'Agent']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'BizDev', 'Ops']);
    }
    match /projects/{id} {
      allow read: if isMember();
      allow create: if hasRole(['Admin', 'BizDev', 'Ops']) && okDoc(id);
      allow update: if hasRole(['Admin', 'BizDev', 'Ops']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'BizDev', 'Ops']);
    }
    match /budgets/{id} {
      allow read: if hasRole(['Admin', 'Finance', 'Auditor']);
      allow create: if hasRole(['Admin', 'Finance']) && okDoc(id);
      allow update: if hasRole(['Admin', 'Finance']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Finance']);
    }
    match /assets/{id} {
      allow read: if hasRole(['Admin', 'Finance', 'Ops', 'Auditor']);
      allow create: if hasRole(['Admin', 'Finance']) && okDoc(id);
      allow update: if hasRole(['Admin', 'Finance']) && okDoc(id);
      allow delete: if hasRole(['Admin', 'Finance']);
    }
  }
}
