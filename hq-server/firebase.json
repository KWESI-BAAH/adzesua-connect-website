{
  "firestore": { "rules": "firestore.rules" },
  "functions": [
    { "source": "functions", "codebase": "default", "runtime": "nodejs22", "ignore": ["node_modules", ".git", "*.log"] }
  ],
  "hosting": {
    "site": "adzesua-hq",
    "public": "public",
    "predeploy": ["rm -rf \"$PROJECT_DIR/public\" && cp -r \"$PROJECT_DIR/../hq\" \"$PROJECT_DIR/public\" && rm -f \"$PROJECT_DIR/public/firestore.rules\""],
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ] },
      { "source": "**/*.@(js|css|html)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
    ]
  }
}
